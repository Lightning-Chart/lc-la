# Repository maintainer configuration for local example development.
# Copy this file to .env and fill in your license key.
# Get a license at https://lightningchart.com/js-charts/

# Required: Your LightningChart JS license key
LCJS_LICENSE_KEY=your-license-key-here

# Optional: For app deployment licenses
LCJS_APP_TITLE=
LCJS_COMPANY=

# Optional: Required only when publishing the C# NuGet package.
NUGET_API_KEY=

# Optional: Required only to enable the live performance demo on the docs site
# (website/src/components/PerformanceDemo.tsx). Use a domain-locked deployment
# key restricted to the docs site's domain, not a personal/commercial key.
LCJS_DOCS_LICENSE_KEY=
