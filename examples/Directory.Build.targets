<Project>
  <!--
    With -p:LclaUseLocalSource=true, examples build against the local C# client library instead of the LCLA NuGet package.
  -->
  <ItemGroup Condition="'$(LclaUseLocalSource)' == 'true'">
    <PackageReference Remove="LCLA" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\packages\clients\csharp\LightningChart.LA\LightningChart.LA.csproj" />
  </ItemGroup>
</Project>
