@page "/radzen-charts"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using BlazorServerComparison.Data
@using Radzen.Blazor

<PageTitle>Radzen Blazor Performance Test</PageTitle>

<div class="benchmark-page benchmark-radzen">
    <style>
            .benchmark-radzen .rz-path-transition {
                transition-duration: 100ms;
                transition-timing-function: linear;
            }
    </style>
    <header class="benchmark-header">
        <div>
            <span class="benchmark-kicker">BLAZOR SERVER · XY PERFORMANCE TEST</span>
        </div>

        <span class="benchmark-library-badge">Radzen Blazor</span>
    </header>

    <section class="benchmark-metrics" aria-label="Test configuration">
        <article>
            <span>Historical samples</span>
            <strong>@_sampleCount.ToString("N0")</strong>
        </article>
        <article>
            <span>Streaming rate</span>
            <strong>100</strong>
            <small>samples/s</small>
        </article>
        <article>
            <span>Batch size</span>
            <strong>@BatchSize</strong>
            <small>samples</small>
        </article>
        <article>
            <span>Live X interval</span>
            <strong>5</strong>
            <small>seconds</small>
        </article>
    </section>

    @if (_error is not null)
    {
        <p role="alert" class="alert alert-danger">@_error</p>
    }

    <main class="benchmark-chart-grid">
        <section class="benchmark-card">
            <header class="benchmark-card-header">
                <div>
                    <span class="benchmark-card-index">01</span>
                    <div>
                        <h2>Historical dataset</h2>
                        <p>High-volume static line series</p>
                    </div>
                </div>
                <span class="benchmark-card-status">@(_ready ? "Loaded" : "Loading")</span>
            </header>

            <div class="benchmark-chart-frame">
                @_historicalChart
            </div>

            <footer class="benchmark-card-footer">
                <span>Dataset</span>
                <strong>@_sampleCount.ToString("N0") points</strong>
            </footer>
        </section>

        <section class="benchmark-card">
            <header class="benchmark-card-header">
                <div>
                    <span class="benchmark-card-index">02</span>
                    <div>
                        <h2>Real-time stream</h2>
                        <p>Continuously appended scrolling signal</p>
                    </div>
                </div>

                <button class="benchmark-control" @onclick="ToggleAsync" disabled="@(!_ready || _error is not null)">
                    @(_isRunning ? "Pause" : "Run")
                </button>
            </header>

            <div class="benchmark-chart-frame">
                <RadzenChart @ref="_realtimeChart" Style="height: 100%;" AllowSeriesHover="false" AllowZoom="true" AllowPan="true" Animate="true" AnimationDuration="100" AnimateDataUpdates="true">
                    <RadzenLineSeries TItem="LinePoint" Data="_realtimePoints" CategoryProperty="X" ValueProperty="Y"
                                      Title="Value" Stroke="#f4b942" StrokeWidth="2" Smooth="false" />
                    <RadzenCategoryAxis Min="@_realtimeMin" Max="@_realtimeMax"><RadzenAxisTitle Text="Time (s)" /></RadzenCategoryAxis>
                    <RadzenValueAxis Min="@(-1.25)" Max="@(1.25)" />
                    <RadzenLegend Visible="true" />
                    <RadzenChartTooltipOptions Visible="true" />
                </RadzenChart>
            </div>

            <footer class="benchmark-card-footer">
                <span class="benchmark-runtime-state @(_isRunning ? "is-running" : null)">
                    <i></i>
                    @(_isRunning ? "Running" : "Paused")
                </span>
                <strong>@_receivedSamples.ToString("N0") samples received</strong>
            </footer>
        </section>
    </main>
</div>

@code {
    private const int BatchSize = 10;
    private readonly DataGenerator _generator = new(seed: 42);
    private CancellationTokenSource? _cancellation;
    private Task? _streamTask;
    private bool _ready;
    private bool _isRunning;
    private bool _disposed;
    private int _sampleCount = 1_000_000;
    private int _receivedSamples;
    private string? _error;

    private readonly List<LinePoint> _staticPoints = new();
    private List<LinePoint> _realtimePoints = new();
    private RenderFragment? _historicalChart;
    private double _historicalMax;
    private RadzenChart? _realtimeChart;
    private double _realtimeMin = -5;
    private double _realtimeMax;

    protected override void OnInitialized()
    {
        var historicalData = DataGenerator.CreateHistorical(_sampleCount);
        _staticPoints.AddRange(ToPoints(historicalData));
        _historicalMax = historicalData.X[^1];

        // Keep the million-point chart out of the streaming render cycle.
        RenderFragment historicalContent = @<RadzenChart Style="height: 100%;" AllowSeriesHover="false" AllowZoom="true" AllowPan="true" Animate="false" AnimateDataUpdates="false">
            <RadzenLineSeries TItem="LinePoint" Data="_staticPoints" CategoryProperty="X" ValueProperty="Y"
                              Title="Value" Stroke="#f4b942" StrokeWidth="2" Smooth="false" />
            <RadzenCategoryAxis Min="0" Max="@_historicalMax"><RadzenAxisTitle Text="Time (s)" /></RadzenCategoryAxis>
            <RadzenValueAxis Min="@(-1.25)" Max="@(1.25)" />
            <RadzenLegend Visible="true" />
            <RadzenChartTooltipOptions Visible="true" />
        </RadzenChart>;
        _historicalChart = builder =>
        {
            builder.OpenComponent<HistoricalChartHost>(0);
            builder.AddAttribute(1, nameof(HistoricalChartHost.ChildContent), historicalContent);
            builder.CloseComponent();
        };
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ready = true;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private static List<LinePoint> ToPoints(LineChartData data) =>
        data.X.Select((x, i) => new LinePoint(x, data.Y[i])).ToList();

    public sealed record LinePoint(double X, double Y);

    // The first render still runs; subsequent parent renders do not redraw this chart.
    private sealed class HistoricalChartHost : ComponentBase
    {
        [Parameter] public RenderFragment? ChildContent { get; set; }

        protected override bool ShouldRender() => false;

        protected override void BuildRenderTree(
            Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
            => builder.AddContent(0, ChildContent);
    }

    private async Task ToggleAsync()
    {
        if (!_ready || _disposed || _error is not null) return;
        if (_isRunning)
        {
            await StopAsync();
            return;
        }

        _isRunning = true;
        _cancellation = new CancellationTokenSource();
        _streamTask = StreamAsync(_cancellation.Token);
    }

    private async Task StreamAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var batch = _generator.NextBatch(BatchSize);
                await InvokeAsync(() =>
                {
                    if (_disposed || cancellationToken.IsCancellationRequested || _realtimeChart is null) return;
                    _realtimePoints = [.. _realtimePoints, .. ToPoints(batch)];
                    _realtimeMax = batch.X[^1];
                    _realtimeMin = _realtimeMax - 5;
                    _receivedSamples += batch.X.Length;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Expected when Pause is pressed or the page is closed.
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                _error = $"Streaming stopped: {ex.Message}";
                _isRunning = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task StopAsync()
    {
        var cancellation = _cancellation;
        if (cancellation is null) return;
        var streamTask = _streamTask;
        _cancellation = null;
        _streamTask = null;
        _isRunning = false;
        await cancellation.CancelAsync();
        try { if (streamTask is not null) await streamTask; }
        finally { cancellation.Dispose(); }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await StopAsync();

    }
}





