{
  "name": "@lcla/host",
  "version": "0.0.6",
  "type": "module",
  "description": "LightningChart LA host bundle — runs in-browser alongside LCJS",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/lcla-host.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/compact-bundle.mjs",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@lightningchart/lcjs": "8.2.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vite": "^6.0.0"
  }
}
